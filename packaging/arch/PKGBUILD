# Maintainer: sucuklutank123456789-coder
pkgname=tokenpanel
pkgver=0.1.0
pkgrel=1
pkgdesc="System tray panel showing Claude Code and Codex token usage"
arch=('any')
url="https://github.com/sucuklutank123456789-coder/token-panel"
license=('MIT')
depends=('python' 'pyside6')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('gnome-shell-extension-appindicator: tray icon support on GNOME')
source=()

# Builds from the repository root: `cd packaging/arch && makepkg -si`
_root="$(realpath "$startdir/../..")"

build() {
  cd "$_root"
  rm -rf "$srcdir/dist"
  python -m build --wheel --no-isolation --outdir "$srcdir/dist"
}

check() {
  cd "$_root"
  python -m unittest discover -s tests -t .
}

package() {
  cd "$_root"
  python -m installer --destdir="$pkgdir" "$srcdir"/dist/*.whl
  install -Dm644 data/tokenpanel.desktop "$pkgdir/usr/share/applications/tokenpanel.desktop"
  install -Dm644 data/tokenpanel.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/tokenpanel.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
